# VESA Transit Environment Configuration

# PostgreSQL Connection String (Required in production, e.g., Render PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL=postgresql://vesa_user:vesa_secure_password@dpg-xxxx.render.com/vesa_transit?sslmode=require

# JWT Secret Key for signing authentication tokens (min 32 characters recommended)
JWT_SECRET=replace_with_a_secure_random_32_character_jwt_secret_key

# Frontend Allowed Origin for CORS (e.g. your Render web service or local dev)
FRONTEND_ORIGIN=https://vesa-transit.onrender.com

# Backend Server Port (defaults to 5001 if not specified)
PORT=5001

# Environment Mode (production / development)
NODE_ENV=production
